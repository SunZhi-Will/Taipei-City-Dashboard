# Airflow DE 環境變數範本 / Airflow DE Environment Variables Template
# 使用方式：cp .env.template .env  （然後填入實際值）
#
# ⚠️ 重要：Airflow 使用獨立 docker-compose 網路（develop_default），
#    需透過 host.docker.internal 連接主 stack 的 postgres-manager / redis。
#    本機 macOS/Windows Docker Desktop 支援 host.docker.internal。
#    Linux 請改用實際主機 IP 或設定 extra_hosts。

# ============================================================
# Airflow Metadata DB（PostgreSQL）
# postgres-manager 對外 port 為 5433（見 docker-compose-db.yaml）
# 請先確保 airflow_meta 資料庫已建立：
#   docker exec -it postgres-manager psql -U postgres -c "CREATE DATABASE airflow_meta;"
# ============================================================
MATADATA_DATABASE=postgresql+psycopg2://postgres:CHANGE_ME@host.docker.internal:5433/airflow_meta

# ============================================================
# Celery Result Backend（同 Metadata DB）
# ============================================================
CELERY_RESULT_BACKEND=db+postgresql://postgres:CHANGE_ME@host.docker.internal:5433/airflow_meta

# ============================================================
# Redis Broker
# 注意：docker-compose-db.yaml 的 redis 預設不暴露 host port，
# 需在 docker-compose-db.yaml 的 redis 服務加上：
#   ports:
#     - "6379:6379"
# 再執行 docker compose -f docker-compose-db.yaml up -d
# ============================================================
REDIS_CONN=redis://:@host.docker.internal:6379/0

# ============================================================
# Airflow 管理員帳號（首次 airflow-init 建立）
# ============================================================
USERNAME=airflow
PASSWORD=airflow

# ============================================================
# Airflow 容器執行 UID（Linux: id -u；Mac/Windows Docker Desktop 固定用 50000）
# ============================================================
AIRFLOW_UID=50000

# ============================================================
# DAG/Log/Plugin 掛載根目錄（相對於本 compose 檔案所在位置）
# 預設 ../../ 指向 Taipei-City-Dashboard-DE/
# 通常不需更改
# ============================================================
# AIRFLOW_PROJ_DIR=../../
