}

.map-dashboard-row {
	display: grid;
	grid-template-columns: 1fr auto;
	align-items: center;
	background: rgba(255, 255, 255, 0.06);

	button:last-child {
		width: 36px;
		display: flex;
		align-items: center;
		justify-content: center;

		span {
			font-family: var(--font-icon);
		}
	}
}

.map-component-list {
	display: grid;
	gap: 3px;
	padding: 4px;
	max-height: 280px;
	overflow-y: auto;

	p {
		font-size: 0.75rem;
		color: #b9bec7;
		padding: 4px;
	}
}

.map-component-item {
	display: grid;
	grid-template-columns: auto 1fr auto;
	align-items: center;
	gap: 4px;
	padding: 3px 4px;
	border-radius: 8px;

	span {
		font-size: 0.72rem;
		line-height: 1.2;
	}

	small {
		color: #ffb48f;
		font-size: 0.68rem;
	}
}
</style>

