	position: relative;
	width: 100vw;
	height: calc(100vh);
	height: calc(var(--vh) * 100);
	overflow: hidden;
	background: #0b0d0f;

	&-map {
		width: 100%;
		height: 100%;
	}

	&-topbar {
		position: absolute;
		top: 12px;
		left: 12px;
		right: 12px;
		height: 56px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 12px;
		background: rgba(10, 13, 16, 0.74);
		backdrop-filter: blur(8px);
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 18px;
		z-index: 30;
	}

	&-logo-btn {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.12);
		display: flex;
		align-items: center;
		justify-content: center;
		border: none;

		img {
			width: 22px;
			height: 22px;
			filter: invert(1);
		}
	}

	&-title {
		display: flex;
		flex-direction: column;
		gap: 2px;
		margin-left: 10px;
		margin-right: auto;

		p {
			font-size: 0.65rem;
			color: #b7bcc3;
		}

		h1 {
			font-size: 0.95rem;
			font-weight: 600;
		}
	}

	&-nav-wrap {
		position: relative;
	}

	&-nav-toggle {
		width: 38px;
		height: 38px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.12);
		border: none;

		span {
			font-family: var(--font-icon);
		}
	}

	&-nav-menu {
		position: absolute;
		top: 44px;
		right: 0;
		width: 210px;
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 8px;
		background: rgba(16, 20, 24, 0.96);
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 10px;

		a {
			padding: 8px;
			border-radius: 8px;
			color: #f2f4f8;
		}

		a:hover {
			background: rgba(255, 255, 255, 0.1);
		}
	}
}

.map-island {
	position: absolute;
	top: 68px;
	left: 12px;
	width: 260px;
	max-height: calc(100% - 80px);
	display: flex;
	flex-direction: column;
	background: rgba(12, 16, 19, 0.82);
	backdrop-filter: blur(12px);
	border: 1px solid rgba(255, 255, 255, 0.16);
	border-radius: 22px;
	z-index: 20;
	overflow: hidden;
	transition: width 0.25s ease, opacity 0.2s ease;

	&-collapsed {
		width: 54px;

		.map-island-header h2 {
			display: none;
		}
	}
}

.map-logo-btn {
	position: absolute;
	top: 12px;
	left: 12px;
	width: 48px;
	height: 48px;
	border-radius: 50%;
	background: rgba(12, 16, 19, 0.82);
	backdrop-filter: blur(12px);
	border: 1px solid rgba(255, 255, 255, 0.16);
	display: flex;
	align-items: center;
	justify-content: center;
	z-index: 25;

	img {
		width: 24px;
		height: 24px;
		filter: invert(1);
	}

	&:hover {
		background: rgba(12, 16, 19, 0.95);
		border-color: rgba(255, 255, 255, 0.24);
	}

	&-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 10px 12px;
		background: rgba(255, 255, 255, 0.06);

		h2 {
			font-size: 0.86rem;
			font-weight: 600;
		}

		button span {
			font-family: var(--font-icon);
		}
	}

	&-content {
		overflow-y: auto;
		padding: 6px;
		display: grid;
		gap: 6px;
	}
}

.map-group {
	border: 1px solid rgba(255, 255, 255, 0.12);
	border-radius: 14px;
	padding: 6px;
	background: rgba(0, 0, 0, 0.2);
}

.map-group-title,
.map-sub-title,
.map-dashboard-row button {
	width: 100%;
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 6px 8px;
	border-radius: 10px;
	text-align: left;
}

.map-group-title,
.map-sub-title {
	font-weight: 600;
	background: rgba(255, 255, 255, 0.08);

	span {
		font-family: var(--font-icon);
	}
}

.map-sub-title {
	margin-top: 4px;
	font-size: 0.75rem;
}

.map-city-select {
	width: 100%;
	margin-top: 8px;
	margin-bottom: 8px;
	font-size: 0.8rem;
}

.map-dashboard-list {
	display: grid;
	gap: 4px;
}

.map-dashboard-item {
	border: 1px solid rgba(255, 255, 255, 0.1);
	border-radius: 10px;
