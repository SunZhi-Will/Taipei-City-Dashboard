{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "F5: Docker Quick Deploy",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "bash .vscode/scripts/docker-task.sh quick-up --follow --stop-on-interrupt"
    },
    {
      "name": "F5: Docker Full Bootstrap",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "bash .vscode/scripts/docker-task.sh bootstrap-full --follow --stop-on-interrupt"
    }
  ]
}
