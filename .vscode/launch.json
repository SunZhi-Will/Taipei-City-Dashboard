{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "F5: Docker Quick Deploy",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/docker",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& '${workspaceFolder}\\.vscode\\scripts\\docker-task.ps1' -Action status\"",
      "preLaunchTask": "docker:quick-up"
    },
    {
      "name": "F5: Docker Full Bootstrap",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/docker",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& '${workspaceFolder}\\.vscode\\scripts\\docker-task.ps1' -Action status\"",
      "preLaunchTask": "docker:bootstrap-full"
    }
  ]
}
